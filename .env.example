# =============================================================================
# JT Sports Commerce — Environment Variables
# Copy to .env / Railway service variables. Never commit secrets.
# =============================================================================

# ----- Next.js (apps/web) -----
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
WORDPRESS_URL=https://cms.yourdomain.com
WORDPRESS_API_URL=https://cms.yourdomain.com/wp-json
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=redis://default:password@redis.railway.internal:6379
JT_INTERNAL_API_SECRET=
REVALIDATE_SECRET=

# ----- Worker (apps/worker) -----
# REDIS_URL=
# WORDPRESS_URL=
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
# JT_INTERNAL_API_SECRET=
# NEXT_PUBLIC_SITE_URL=
# REVALIDATE_SECRET=

# ----- WordPress -----
WORDPRESS_DB_HOST=mysql.railway.internal
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
WP_HOME=https://cms.yourdomain.com
WP_SITEURL=https://cms.yourdomain.com
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=DXB
ARAMEX_ACCOUNT_COUNTRY=AE
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
# REDIS_URL=
JT_STOREFRONT_ORIGIN=https://www.yourdomain.com
JT_REVALIDATE_URL=https://www.yourdomain.com/api/revalidate
# REVALIDATE_SECRET=

# ----- MySQL (Railway) -----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=
